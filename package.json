{
  "name": "lp-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --offline",
    "start:clear": "expo start --clear --offline",
    "start:online": "expo start",
    "start:tunnel": "expo start --tunnel --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:setup": "node setup-ios.js",
    "ios:test": "node setup-ios.js && expo start --offline",
    "web": "expo start --web",
    "api:types": "openapi-typescript ../lp-api/openapi.json -o ./app/generated/api.ts",
    "build:ios": "node ./node_modules/eas-cli/bin/run build --platform ios --profile production",
    "build:android": "node ./node_modules/eas-cli/bin/run build --platform android --profile production",
    "build:all": "node ./node_modules/eas-cli/bin/run build --platform all --profile production",
    "submit:ios": "node ./node_modules/eas-cli/bin/run submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.17.9",
    "axios": "^1.6.5",
    "expo": "~54.0.0",
    "expo-apple-authentication": "^55.0.13",
    "expo-calendar": "~15.0.7",
    "expo-constants": "~18.0.13",
    "expo-device": "^55.0.15",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.22",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mask-input": "^1.2.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "eas-cli": "^18.7.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.3.3"
  },
  "private": true,
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@babel/core": "^7.26.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22"
}
